<Window x:Class="AtazaKudeatzailea.AtazaLeihoa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ataza"
        Height="300"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        

        <Grid Grid.Row="0"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Titulua:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="txtTitulua"
                     Grid.Column="1"/>

        </Grid>


        

        <Grid Grid.Row="1"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Lehentasuna:"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="cmbLehentasuna"
                      Grid.Column="1">

                <ComboBoxItem Content="Baxua"/>
                <ComboBoxItem Content="Ertaina"/>
                <ComboBoxItem Content="Handia"/>

            </ComboBox>

        </Grid>


        

        <Grid Grid.Row="2"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Azken eguna:"
                       VerticalAlignment="Center"/>

            <DatePicker x:Name="dpAzkenEguna"
                        Grid.Column="1"/>

        </Grid>


        

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Gorde"
                    Width="70"
                    Margin="5"
                    Click="Gorde_Click"/>

            <Button Content="Utzi"
                    Width="70"
                    Margin="5"
                    Click="Utzi_Click"/>

        </StackPanel>

    </Grid>

</Window>
<Window x:Class="AtazaKudeatzailea.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ataza-kudeatzailea"
        Height="600"
        Width="950"
         WindowStartupLocation="CenterScreen"
         Closing="Window_Closing">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <DataGrid x:Name="dgAtazak"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Titulua"
                                    Binding="{Binding Titulua}"
                                    IsReadOnly="True"
                                    Width="*"/>


                <DataGridTextColumn Header="Lehentasuna"
                                    Binding="{Binding Lehentasuna}"
                                    IsReadOnly="True"
                                    Width="150"/>


                <DataGridTextColumn Header="Azken eguna"
                                    Binding="{Binding AzkenEguna, StringFormat=yyyy-MM-dd}"
                                    IsReadOnly="True"
                                    Width="150"/>


                <DataGridCheckBoxColumn Header="Egina"
                                        Binding="{Binding Eginda, Mode=TwoWay}"
                                        Width="100"/>

            </DataGrid.Columns>

        </DataGrid>


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Berria"
                    Width="55"
                    Margin="5"
                    Click="Berria_Click"/>

            <Button Content="Editatu"
                    Width="65"
                    Margin="5"
                    Click="Editatu_Click"/>

            <Button Content="Ezabatu"
                    Width="65"
                    Margin="5"
                    Click="Ezabatu_Click"/>

            <Button Content="Irten"
                    Width="55"
                    Margin="5"
                    Click="Irten_Click"/>

        </StackPanel>

    </Grid>

</Window>